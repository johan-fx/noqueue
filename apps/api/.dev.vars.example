# Copy to .dev.vars (ignored). Generate each cryptographic key independently with openssl rand -hex 32.
# Never use real 360dialog credentials for local browser tests (dev:e2e config is isolated).
D360DIALOG_API_KEY=
D360DIALOG_WEBHOOK_TOKEN=
PII_ENCRYPTION_KEY=
PHONE_HASH_KEY=
RECOVERY_TOKEN_KEY=
PILOT_ACCESS_TOKEN=
# Local-only mailbox reader (min. 32 characters). Used only with
# AUTH_EMAIL_API_KEY="local-inbox" and never deploy it.
LOCAL_DEV_TOKEN=
WHATSAPP_RECIPIENT_ALLOWLIST=

# Authentication: generate a separate random secret per environment (>=32 characters).
BETTER_AUTH_SECRET=""
# Optional: verifying a new profile email only (not needed for onboarding/login).
# `local-inbox` captures verification links in memory while using `pnpm dev`.
# Replace with a Resend API key and verified sender only when testing real delivery.
# Never expose either in VITE_*.
AUTH_EMAIL_API_KEY=""
AUTH_EMAIL_FROM="NoQueue <access@your-verified-domain.example>"

# Native push: keep OFF until explicitly authorized, migrated and configured.
# Separate secrets per local/staging/production; never expose them in VITE_*.
MOBILE_PUSH_ENABLED=false
MOBILE_PUSH_TOKEN_KEY=
# Legacy direct APNs adapter only; current routes/dispatcher use FCM on both platforms.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
# Explicit sandbox or production, matched to the signed app entitlement (not inferred).
APNS_ENVIRONMENT=
# Operational gate, not a protocol switch. Set only after verifying HTTP/2 in
# the actual target runtime/environment; local Node probes and mocks do not count.
APNS_TRANSPORT_VERIFIED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Independent rollout for FCM on iOS; APNs keys live in Firebase, never the app.
FCM_IOS_ENABLED=false
FCM_IOS_BUNDLE_ID=com.noqueue-app.ios
