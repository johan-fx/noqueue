{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noqueue-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/assets/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noqueue-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUEUE_COORDINATOR",
        "class_name": "QueueCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "QueueCoordinator"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATIONS",
        "queue": "noqueue-whatsapp-local"
      },
      {
        "binding": "NOTIFICATIONS_DLQ",
        "queue": "noqueue-whatsapp-local-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "noqueue-whatsapp-local",
        "dead_letter_queue": "noqueue-whatsapp-local-dlq",
        "max_retries": 3,
        "max_batch_size": 10
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "*/15 * * * *"
    ]
  },
  "vars": {
    "QUEUE_AUTO_REPLACEMENT_ENABLED": "false",
    "METRICS_CAPTURE_ENABLED": "true",
    "METRICS_DASHBOARD_ENABLED": "true",
    "WHATSAPP_MODE": "sandbox",
    "WHATSAPP_ENABLED": "false",
    "CONFIRMATION_EXPERIMENT_ENABLED": "false",
    "STAGING_EXPERIMENT_APPROVED": "false",
    "STAGING_EXPERIMENT_OPEN_RECIPIENTS": "false",
    "PUBLIC_APP_ORIGIN": "http://localhost:5173",
    "WHATSAPP_QUEUE_JOINED_TEMPLATE_ES": "noqueue_queue_joined",
    "WHATSAPP_QUEUE_JOINED_TEMPLATE_EN": "noqueue_queue_joined",
    "D360DIALOG_REQUEST_TIMEOUT_MS": "10000",
    "STAGING_CONSENT_APPROVED": "false",
    "APP_ENV": "local",
    "D360DIALOG_PHONE_NUMBER_ID": "",
    "VENUE_LOGOS_PUBLIC_BASE_URL": "/api/v1/venue-logos"
  },
  "env": {
    "sandbox": {
      "name": "noqueue-api-sandbox",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "QUEUE_AUTO_REPLACEMENT_ENABLED": "false",
        "WHATSAPP_MODE": "sandbox",
        "WHATSAPP_ENABLED": "false",
        "CONFIRMATION_EXPERIMENT_ENABLED": "false",
        "STAGING_EXPERIMENT_APPROVED": "false",
        "STAGING_EXPERIMENT_OPEN_RECIPIENTS": "false",
        "PUBLIC_APP_ORIGIN": "https://sandbox.noqueue-app.com",
        "WHATSAPP_QUEUE_JOINED_TEMPLATE_ES": "noqueue_queue_joined",
        "WHATSAPP_QUEUE_JOINED_TEMPLATE_EN": "noqueue_queue_joined",
        "D360DIALOG_REQUEST_TIMEOUT_MS": "10000",
        "STAGING_CONSENT_APPROVED": "false",
        "APP_ENV": "sandbox",
        "D360DIALOG_PHONE_NUMBER_ID": "",
        "VENUE_LOGOS_PUBLIC_BASE_URL": "https://assets-sandbox.noqueue-app.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "noqueue-sandbox",
          "database_id": "14e31648-143e-4165-9a05-c865a09277eb",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "QUEUE_COORDINATOR",
            "class_name": "QueueCoordinator"
          }
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATIONS",
            "queue": "noqueue-whatsapp-sandbox"
          },
          {
            "binding": "NOTIFICATIONS_DLQ",
            "queue": "noqueue-whatsapp-sandbox-dlq"
          }
        ],
        "consumers": [
          {
            "queue": "noqueue-whatsapp-sandbox",
            "dead_letter_queue": "noqueue-whatsapp-sandbox-dlq",
            "max_retries": 3,
            "max_batch_size": 10
          }
        ]
      },
      "routes": [
        {
          "pattern": "sandbox.noqueue-app.com",
          "custom_domain": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "VENUE_LOGOS",
          "bucket_name": "noqueue-venue-logos-sandbox"
        }
      ]
    },
    "staging": {
      "name": "noqueue-api-staging",
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "QUEUE_AUTO_REPLACEMENT_ENABLED": "false",
        "WHATSAPP_MODE": "cloud",
        "WHATSAPP_ENABLED": "false",
        "CONFIRMATION_EXPERIMENT_ENABLED": "false",
        "STAGING_EXPERIMENT_APPROVED": "false",
        "STAGING_EXPERIMENT_OPEN_RECIPIENTS": "false",
        "PUBLIC_APP_ORIGIN": "https://staging.noqueue-app.com",
        "METRICS_CRON_RECOVERY_ENABLED": "true",
        "METRICS_SERVICE_SNAPSHOT_CAPTURE_SINCE": "2026-10-11T00:00:00Z",
        "METRICS_CAPTURE_ENABLED": "true",
        "METRICS_DASHBOARD_ENABLED": "true",
        "WHATSAPP_QUEUE_JOINED_TEMPLATE_ES": "noqueue_queue_joined",
        "WHATSAPP_QUEUE_JOINED_TEMPLATE_EN": "noqueue_queue_joined",
        "D360DIALOG_REQUEST_TIMEOUT_MS": "10000",
        "STAGING_CONSENT_APPROVED": "false",
        "APP_ENV": "staging",
        "D360DIALOG_PHONE_NUMBER_ID": "",
        "WHATSAPP_COPY_VERSION": "4",
        "WHATSAPP_QUEUE_V4_QUEUE_JOINED_TEMPLATE_ES": "noqueue_v4_queue_joined_es_staging",
        "WHATSAPP_QUEUE_V4_QUEUE_JOINED_TEMPLATE_EN": "noqueue_v4_queue_joined_en_staging",
        "WHATSAPP_QUEUE_V4_APPROACHING_TEMPLATE_ES": "noqueue_v4_approaching_es",
        "WHATSAPP_QUEUE_V4_APPROACHING_TEMPLATE_EN": "noqueue_v4_approaching_en",
        "WHATSAPP_QUEUE_V4_DELAYED_TEMPLATE_ES": "noqueue_v4_delayed_es",
        "WHATSAPP_QUEUE_V4_DELAYED_TEMPLATE_EN": "noqueue_v4_delayed_en",
        "WHATSAPP_QUEUE_V4_READY_TEMPLATE_ES": "noqueue_v4_ready_es_staging",
        "WHATSAPP_QUEUE_V4_READY_TEMPLATE_EN": "noqueue_v4_ready_en_staging",
        "WHATSAPP_QUEUE_V4_IMPROVED_WAIT_RECOMMENDED_TEMPLATE_ES": "noqueue_v4_improved_wait_recommended_es",
        "WHATSAPP_QUEUE_V4_IMPROVED_WAIT_RECOMMENDED_TEMPLATE_EN": "noqueue_v4_improved_wait_recommended_en",
        "WHATSAPP_QUEUE_V4_IMPROVED_WAIT_NEUTRAL_TEMPLATE_ES": "noqueue_v4_improved_wait_neutral_es",
        "WHATSAPP_QUEUE_V4_IMPROVED_WAIT_NEUTRAL_TEMPLATE_EN": "noqueue_v4_improved_wait_neutral_en",
        "WHATSAPP_QUEUE_V4_IMPROVED_READY_TEMPLATE_ES": "noqueue_v4_improved_ready_es_staging",
        "WHATSAPP_QUEUE_V4_IMPROVED_READY_TEMPLATE_EN": "noqueue_v4_improved_ready_en_staging",
        "WHATSAPP_QUEUE_V4_EXPIRED_TEMPLATE_ES": "noqueue_v4_expired_es_staging",
        "WHATSAPP_QUEUE_V4_EXPIRED_TEMPLATE_EN": "noqueue_v4_expired_en_staging",
        "WHATSAPP_QUEUE_V4_CANCELLED_CUSTOMER_TEMPLATE_ES": "noqueue_v4_cancelled_customer_es_staging",
        "WHATSAPP_QUEUE_V4_CANCELLED_CUSTOMER_TEMPLATE_EN": "noqueue_v4_cancelled_customer_en_staging",
        "WHATSAPP_QUEUE_V4_CANCELLED_STAFF_TEMPLATE_ES": "noqueue_v4_cancelled_staff_es_staging",
        "WHATSAPP_QUEUE_V4_CANCELLED_STAFF_TEMPLATE_EN": "noqueue_v4_cancelled_staff_en_staging",
        "WHATSAPP_QUEUE_V4_CANCELLED_UNKNOWN_TEMPLATE_ES": "noqueue_v4_cancelled_unknown_es_staging",
        "WHATSAPP_QUEUE_V4_CANCELLED_UNKNOWN_TEMPLATE_EN": "noqueue_v4_cancelled_unknown_en_staging",
        "WHATSAPP_QUEUE_V4_SERVICE_ENDED_TEMPLATE_ES": "noqueue_v4_service_ended_es",
        "WHATSAPP_QUEUE_V4_SERVICE_ENDED_TEMPLATE_EN": "noqueue_v4_service_ended_en",
        "VENUE_LOGOS_PUBLIC_BASE_URL": "https://assets-staging.noqueue-app.com",
        "VENUE_LOGOS_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "noqueue-staging",
          "database_id": "73a50d85-e53f-4a54-b164-07b80a39d1a8",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "QUEUE_COORDINATOR",
            "class_name": "QueueCoordinator"
          }
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATIONS",
            "queue": "noqueue-whatsapp-staging"
          },
          {
            "binding": "NOTIFICATIONS_DLQ",
            "queue": "noqueue-whatsapp-staging-dlq"
          }
        ],
        "consumers": [
          {
            "queue": "noqueue-whatsapp-staging",
            "dead_letter_queue": "noqueue-whatsapp-staging-dlq",
            "max_retries": 3,
            "max_batch_size": 10
          }
        ]
      },
      "routes": [
        {
          "pattern": "staging.noqueue-app.com",
          "custom_domain": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "VENUE_LOGOS",
          "bucket_name": "noqueue-venue-logos-staging",
          "jurisdiction": "eu"
        }
      ]
    },
    "production": {
      "name": "noqueue-api-production",
      "triggers": {
        "crons": [
          "* * * * *",
          "*/15 * * * *"
        ]
      },
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "WHATSAPP_MODE": "cloud",
        "WHATSAPP_ENABLED": "false",
        "CONFIRMATION_EXPERIMENT_ENABLED": "false",
        "STAGING_EXPERIMENT_APPROVED": "false",
        "STAGING_EXPERIMENT_OPEN_RECIPIENTS": "false",
        "PUBLIC_APP_ORIGIN": "https://app.noqueue-app.com",
        "METRICS_CRON_RECOVERY_ENABLED": "false",
        "METRICS_CAPTURE_ENABLED": "true",
        "METRICS_DASHBOARD_ENABLED": "false",
        "WHATSAPP_QUEUE_JOINED_TEMPLATE_ES": "noqueue_queue_joined",
        "WHATSAPP_QUEUE_JOINED_TEMPLATE_EN": "noqueue_queue_joined",
        "D360DIALOG_REQUEST_TIMEOUT_MS": "10000",
        "STAGING_CONSENT_APPROVED": "false",
        "APP_ENV": "production",
        "D360DIALOG_PHONE_NUMBER_ID": "",
        "WHATSAPP_COPY_VERSION": "4",
        "WHATSAPP_QUEUE_V4_QUEUE_JOINED_TEMPLATE_ES": "noqueue_v4_queue_joined_es_production",
        "WHATSAPP_QUEUE_V4_QUEUE_JOINED_TEMPLATE_EN": "noqueue_v4_queue_joined_en_production",
        "WHATSAPP_QUEUE_V4_APPROACHING_TEMPLATE_ES": "noqueue_v4_approaching_es",
        "WHATSAPP_QUEUE_V4_APPROACHING_TEMPLATE_EN": "noqueue_v4_approaching_en",
        "WHATSAPP_QUEUE_V4_DELAYED_TEMPLATE_ES": "noqueue_v4_delayed_es",
        "WHATSAPP_QUEUE_V4_DELAYED_TEMPLATE_EN": "noqueue_v4_delayed_en",
        "WHATSAPP_QUEUE_V4_READY_TEMPLATE_ES": "noqueue_v4_ready_es_production",
        "WHATSAPP_QUEUE_V4_READY_TEMPLATE_EN": "noqueue_v4_ready_en_production",
        "WHATSAPP_QUEUE_V4_IMPROVED_WAIT_RECOMMENDED_TEMPLATE_ES": "noqueue_v4_improved_wait_recommended_es",
        "WHATSAPP_QUEUE_V4_IMPROVED_WAIT_RECOMMENDED_TEMPLATE_EN": "noqueue_v4_improved_wait_recommended_en",
        "WHATSAPP_QUEUE_V4_IMPROVED_WAIT_NEUTRAL_TEMPLATE_ES": "noqueue_v4_improved_wait_neutral_es",
        "WHATSAPP_QUEUE_V4_IMPROVED_WAIT_NEUTRAL_TEMPLATE_EN": "noqueue_v4_improved_wait_neutral_en",
        "WHATSAPP_QUEUE_V4_IMPROVED_READY_TEMPLATE_ES": "noqueue_v4_improved_ready_es_production",
        "WHATSAPP_QUEUE_V4_IMPROVED_READY_TEMPLATE_EN": "noqueue_v4_improved_ready_en_production",
        "WHATSAPP_QUEUE_V4_EXPIRED_TEMPLATE_ES": "noqueue_v4_expired_es_production",
        "WHATSAPP_QUEUE_V4_EXPIRED_TEMPLATE_EN": "noqueue_v4_expired_en_production",
        "WHATSAPP_QUEUE_V4_CANCELLED_CUSTOMER_TEMPLATE_ES": "noqueue_v4_cancelled_customer_es_production",
        "WHATSAPP_QUEUE_V4_CANCELLED_CUSTOMER_TEMPLATE_EN": "noqueue_v4_cancelled_customer_en_production",
        "WHATSAPP_QUEUE_V4_CANCELLED_STAFF_TEMPLATE_ES": "noqueue_v4_cancelled_staff_es_production",
        "WHATSAPP_QUEUE_V4_CANCELLED_STAFF_TEMPLATE_EN": "noqueue_v4_cancelled_staff_en_production",
        "WHATSAPP_QUEUE_V4_CANCELLED_UNKNOWN_TEMPLATE_ES": "noqueue_v4_cancelled_unknown_es_production",
        "WHATSAPP_QUEUE_V4_CANCELLED_UNKNOWN_TEMPLATE_EN": "noqueue_v4_cancelled_unknown_en_production",
        "WHATSAPP_QUEUE_V4_SERVICE_ENDED_TEMPLATE_ES": "noqueue_v4_service_ended_es",
        "WHATSAPP_QUEUE_V4_SERVICE_ENDED_TEMPLATE_EN": "noqueue_v4_service_ended_en",
        "VENUE_LOGOS_PUBLIC_BASE_URL": "https://assets.noqueue-app.com",
        "VENUE_LOGOS_ENABLED": "true",
        "PRODUCTION_WHATSAPP_APPROVED": "false",
        "WHATSAPP_V4_TEMPLATES_APPROVED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "noqueue-production",
          "database_id": "aee70f5d-5c30-47ec-bf97-e24bcd3620e8",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "QUEUE_COORDINATOR",
            "class_name": "QueueCoordinator"
          }
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATIONS",
            "queue": "noqueue-whatsapp-production"
          },
          {
            "binding": "NOTIFICATIONS_DLQ",
            "queue": "noqueue-whatsapp-production-dlq"
          }
        ],
        "consumers": [
          {
            "queue": "noqueue-whatsapp-production",
            "dead_letter_queue": "noqueue-whatsapp-production-dlq",
            "max_retries": 3,
            "max_batch_size": 10
          }
        ]
      },
      "routes": [
        {
          "pattern": "app.noqueue-app.com",
          "custom_domain": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "VENUE_LOGOS",
          "bucket_name": "noqueue-venue-logos-production",
          "jurisdiction": "eu"
        }
      ]
    }
  },
  "account_id": "fa5fab4df1b0f12c946a3ea47fab96eb",
  "r2_buckets": [
    {
      "binding": "VENUE_LOGOS",
      "bucket_name": "noqueue-venue-logos-local"
    }
  ]
}
