{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noqueue-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noqueue-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUEUE_COORDINATOR",
        "class_name": "QueueCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QueueCoordinator"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
