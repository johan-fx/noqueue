{
  "name": "@noqueue/mobile",
  "version": "0.0.0",
  "scripts": {
    "sync": "node scripts/verify-web-build.mjs && NOQUEUE_NATIVE_PLATFORM=ios cap sync ios && NOQUEUE_NATIVE_PLATFORM=android cap sync android",
    "copy": "node scripts/verify-web-build.mjs && NOQUEUE_NATIVE_PLATFORM=ios cap copy ios && NOQUEUE_NATIVE_PLATFORM=android cap copy android",
    "native:run:ios": "NOQUEUE_NATIVE_PLATFORM=ios cap run ios",
    "native:run:android": "NOQUEUE_NATIVE_PLATFORM=android cap run android",
    "native:open:ios": "NOQUEUE_NATIVE_PLATFORM=ios cap open ios",
    "native:open:android": "NOQUEUE_NATIVE_PLATFORM=android cap open android",
    "test:ios": "node scripts/ios-smoke.mjs",
    "test:ios:services": "node scripts/ios-smoke.mjs --services",
    "test:ios:upgrade": "node scripts/ios-smoke.mjs --upgrade",
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "test:ios:lifecycle": "node scripts/ios-smoke.mjs --lifecycle",
    "test:ios:discovery": "node scripts/ios-smoke.mjs --discovery",
    "test:ios:transitions": "node scripts/ios-transitions.mjs",
    "assets": "node scripts/mobile-assets.mjs",
    "assets:check": "node scripts/mobile-assets.mjs --check"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.23.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.1",
    "@capacitor/geolocation": "8.2.0",
    "@capacitor/ios": "8.5.1",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/splash-screen": "8.0.2",
    "@noqueue/native-fcm": "workspace:*",
    "capacitor-native-settings": "8.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.1",
    "@types/node": "^24.13.4",
    "sharp": "0.35.4",
    "typescript": "catalog:"
  }
}
