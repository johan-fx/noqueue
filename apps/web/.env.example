# Empty uses the same origin in the browser. Capacitor builds must set the public API origin.
VITE_API_URL=

# Privacy is OFF by default; never enable in local/staging/preview/native builds.
# Production activation additionally requires the exact HTTPS hostname and recorded consent.
VITE_APP_ENV=local
VITE_ANALYTICS_ENABLED=false
VITE_GA4_MEASUREMENT_ID=
