# Empty uses the same origin in the browser. Capacitor requires an HTTPS origin
# (no /api path, query, credentials or fragment). Mobile API + migration 0029 must
# already be deployed there; mobile builds fail closed if this is missing.
VITE_API_URL=

# Privacy is OFF by default; never enable in local/staging/preview/native builds.
# Production activation additionally requires the exact HTTPS hostname and recorded consent.
VITE_APP_ENV=local
VITE_ANALYTICS_ENABLED=false
VITE_GA4_MEASUREMENT_ID=

# OFF until native projects and backend provider credentials are configured.
VITE_MOBILE_PUSH_ENABLED=false
