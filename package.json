{
  "name": "@noqueue/root",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "pnpm --filter @noqueue/web build && turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "mobile:sync": "turbo run sync --filter=@noqueue/mobile",
    "mobile:ios": "pnpm mobile:sync && pnpm --filter @noqueue/mobile native:run:ios",
    "mobile:android": "pnpm mobile:sync && pnpm --filter @noqueue/mobile native:run:android",
    "test:queue": "node scripts/queue-verification/run.mjs",
    "test:queue:extended": "node scripts/queue-verification/run.mjs --extended",
    "demo:queue:order": "node scripts/queue-demo/run.mjs reception",
    "demo:queue:restaurant": "node scripts/queue-demo/run.mjs restaurant",
    "demo:queue:reception": "node scripts/queue-demo/run.mjs reception",
    "demo:queue:pool": "node scripts/queue-demo/run.mjs pool",
    "demo:queue:all": "node scripts/queue-demo/run.mjs all",
    "demo:queue:adaptive": "node scripts/queue-demo/adaptive-video.mjs record",
    "production:check": "node scripts/production/check.mjs",
    "production:build": "node scripts/production/build.mjs",
    "test:production": "node --test scripts/production/*.test.mjs",
    "production:backup": "node scripts/production/backup-production.mjs",
    "production:deploy": "node scripts/production/deploy.mjs",
    "demo:queue:automatic": "node scripts/queue-demo/automatic-video.mjs record",
    "mobile:assets": "pnpm --filter @noqueue/mobile assets",
    "mobile:release:prepare": "node apps/mobile/scripts/mobile-release-prepare.mjs",
    "mobile:release:verify": "node apps/mobile/scripts/mobile-release-verify.mjs",
    "production:migrations:plan": "node scripts/production/migrations.mjs",
    "production:build:mobile": "node scripts/production/build.mjs --profile mobile-production"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "yaml": "2.9.0"
  }
}
